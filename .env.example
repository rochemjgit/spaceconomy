# Copy to .env for local overrides. Never commit real secrets.
SPACECONOMY_POSTGRES_DB=spaceconomy
SPACECONOMY_POSTGRES_USER=spaceconomy
SPACECONOMY_POSTGRES_PASSWORD=spaceconomy
SPACECONOMY_JWT_SECRET=replace-with-a-long-random-local-secret
SPACECONOMY_LLM_PROVIDER=azure_foundry
SPACECONOMY_AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
SPACECONOMY_AZURE_FOUNDRY_API_KEY=replace-with-a-rotated-foundry-key
SPACECONOMY_AZURE_FOUNDRY_MODEL=gpt-4.1-mini
